# Gemini API Key (server-side only — do NOT prefix with NEXT_PUBLIC_)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# [Optional] If using NEXT_PUBLIC prefix for client-side access (see security Issue #8)
# NEXT_PUBLIC_GEMINI_API_KEY=

# [Optional] Google Cloud Project ID
# NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_ID=
